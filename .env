PROJECT=monadungeon
PS1: '\[\033[1;32m\]\[\033[1;36m\][\u@\h] \[\033[1;34m\]\w\[\033[0;35m\] \[\033[1;36m\]# \[\033[0m\]'
SYMFONY_PHPUNIT_VERSION: 10
COMPOSER_MEMORY_LIMIT: -1
HISTFILE: /root/history/.history
ENV: /root/.bashrc
# Mercure hub (push to the browsers): the backend signs its publish JWT with this key (dev only; prod sets its own)
MERCURE_URL=http://mercure/.well-known/mercure
MERCURE_JWT_SECRET=karak-dev-mercure-secret-at-least-32-bytes

# Google sign-in ("keep this account"): an OAuth client of type Web; "fake" signs in without Google in dev/test
GOOGLE_CLIENT_ID=fake
GOOGLE_CLIENT_SECRET=
